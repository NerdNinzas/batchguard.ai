# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# BatchGuard local data & python
/data/
backend/.venv/
backend/.env
backend/__pycache__/
backend/**/__pycache__/

# GCP service-account keys — never commit
backend/secrets/
*.sa.json

# Reference Vite app studied for the Dograh integration (nested repo; integrated under backend/app/voice + src/app/app/voice)
/ecoforge-voice-dograh/

# simulator app (own package; keep its build artefacts out of the main repo + Cloud Build uploads)
/simulator/node_modules/
/simulator/.next/
/simulator/.env*
!/simulator/.env.example
/simulator/*.tsbuildinfo
/simulator/next-env.d.ts
