{
  "hosting": [
    {
      "target": "app",
      "public": "public",
      "ignore": [
        "**/.*",
        "**/*.md",
        "hosting/**",
        "models/README*"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "batchguard-frontend",
            "region": "asia-southeast1"
          }
        }
      ],
      "headers": [
        {
          "source": "**/*.@(glb|gltf|hdr|exr|bin|woff|woff2|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|svg|avif|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "cleanUrls": false
    },
    {
      "target": "sim",
      "public": "simulator/public",
      "ignore": [
        "**/.*",
        "**/*.md"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "batchguard-simulator",
            "region": "asia-southeast1"
          }
        }
      ],
      "headers": [
        {
          "source": "**/*.@(glb|gltf|hdr|exr|bin|woff|woff2|ttf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|svg|avif|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**",
          "headers": [
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            }
          ]
        }
      ],
      "cleanUrls": false
    }
  ]
}
